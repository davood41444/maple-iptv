// Maple IPTV website: a Cloudflare Worker answering mapleonlinesolutions.com/maple-iptv*
// (the rest of the site is untouched). See site/README.md for going live.
{
  "name": "maple-iptv-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "mapleonlinesolutions.com/maple-iptv*", "zone_name": "mapleonlinesolutions.com" }
  ],
  // Stylesheet, images, coupons.json, and the smaller downloads (public/maple-iptv/…).
  "assets": { "directory": "./public" },
  "d1_databases": [
    { "binding": "DB", "database_name": "maple-iptv", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // Delete installs not seen for a year (see scheduled() in src/index.js).
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "SITE_URL": "https://mapleonlinesolutions.com/maple-iptv",
    "SUPPORT_EMAIL": "info@mapleonlinesolutions.com",
    "CURRENCY": "usd",
    "PRICE_MONTHLY": "399",
    "PRICE_YEARLY": "3999",
    "PAYPAL_MODE": "sandbox",
    "PAYPAL_CLIENT_ID": "",
    "PAYPAL_WEBHOOK_ID": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Where the big downloads live (the Windows installer is too large for the Worker itself).
    "DOWNLOAD_WINDOWS": "",
    "DOWNLOAD_ANDROID": "/maple-iptv/files/MapleIPTV.apk",
    "DOWNLOAD_MAC": "/maple-iptv/files/MapleIPTV-Mac.zip",
    "PLAY_STORE_URL": ""
  }
  // Secrets (wrangler secret put …): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, PAYPAL_CLIENT_SECRET
}
