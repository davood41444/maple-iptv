{
  "name": "maple-iptv",
  "productName": "Maple IPTV",
  "version": "1.2.0",
  "description": "Maple IPTV for Windows, Mac and Linux",
  "author": "Maple Online Solutions <info@mapleonlinesolutions.com>",
  "homepage": "https://mapleonlinesolutions.com",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dir --universal",
    "dist:linux": "electron-builder --linux deb && MAPLE_APPIMAGE=1 electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.mapleonlinesolutions.iptv",
    "productName": "Maple IPTV",
    "copyright": "© Maple Online Solutions",
    "directories": {
      "output": "../dist/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "subtitles.js",
      "downloads.js",
      "vendor/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web"
      }
    ],
    "afterPack": "build/appimage-launcher.js",
    "publish": null,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Maple IPTV",
      "artifactName": "MapleIPTV-Setup.${ext}"
    },
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "executableName": "maple-iptv",
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "IPTV player for live TV, movies and series",
      "description": "Watch your own IPTV subscription (Xtream Codes or M3U): live TV with a program guide, movies and series.",
      "artifactName": "MapleIPTV-Linux.${ext}"
    },
    "deb": {
      "packageName": "maple-iptv"
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
